# Sao chép file này thành .env rồi điền thông tin kết nối MySQL.
# Không commit file .env.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me

# Schema nguồn (chỉ cần quyền SELECT) và schema báo cáo (cần CREATE, INSERT, UPDATE, DELETE)
STAGING_SCHEMA=staging
MART_SCHEMA=ads_mart

# ETL: ngày bắt đầu nạp lịch sử và số ngày nạp lại mỗi lần chạy (dữ liệu quy đổi về trễ)
ETL_BACKFILL_START=2025-01-01
ETL_REFRESH_DAYS=60

# Phân loại từ khóa: số từ (không tính stop-word) tối đa để xem là từ khóa Chung
GENERIC_MAX_WORDS=2

# Danh sách profile_id quảng cáo cần loại khỏi báo cáo, cách nhau bằng dấu phẩy
EXCLUDED_PROFILE_IDS=

# DWH nguồn ở server khác. Khi có SOURCE_DB_HOST, mỗi lần chạy ETL sẽ chép các bảng cần dùng từ
# SOURCE_SCHEMA trên DWH về schema STAGING_SCHEMA trên DB nội bộ (DB_*) rồi mới tổng hợp vào MART_SCHEMA.
# User nguồn chỉ cần quyền SELECT. Để trống SOURCE_DB_HOST nếu staging nằm cùng server với DB_*.
SOURCE_DB_HOST=
SOURCE_DB_PORT=3306
SOURCE_DB_USER=
SOURCE_DB_PASSWORD=
SOURCE_SCHEMA=staging

# Gửi tin cho PIC qua Google Chat. Bật sau khi đã xem trước và gửi thử trên tab "Gửi tin PIC".
NOTIFY_ENABLED=false
# Bỏ qua N ngày gần nhất vì Amazon cập nhật đơn quy đổi trễ
NOTIFY_LAG_DAYS=2
# Link mở web app chèn vào tin nhắn (để trống nếu PIC không truy cập được máy chạy app)
NOTIFY_APP_URL=
# Ngưỡng mặc định: search term tiêu từ $X mà không ra đơn; ACoS mục tiêu khi PIC chưa đặt riêng
NOTIFY_WASTE_SPEND=10
NOTIFY_ACOS_TARGET=0.3

# Tồn kho: CBM của một container 40HQ khi quy đổi số lượng ra container (thực tế 66-74 CBM/container)
INV_CONTAINER_CBM=68

# Giá vốn chuẩn (Standard COGS) trên Google Sheet của BOD, ETL nạp vào ads_mart.ref_std_cogs (etl/std_cogs.py).
# GOOGLE_SA_JSON: đường dẫn file khóa JSON service account đã được chia sẻ quyền xem sheet. Để trống = tải qua link
# export, khi đó sheet phải bật "Bất kỳ ai có đường liên kết đều có thể xem". Để trống COGS_SHEET_ID = bỏ bước này.
COGS_SHEET_ID=
COGS_SHEET_GID=0
GOOGLE_SA_JSON=
# Phí vận hành mỗi đơn vị theo SKU × tháng × nước × kênh (P&L công ty, etl/op_fee.py), tab operation_fee_sales_fc
OPFEE_SHEET_ID=
OPFEE_SHEET_GID=0

# Tồn FBA theo tài khoản trên Google Sheet, tab "inventory details" (etl/fba_sheet.py). Cùng cách đọc như sheet COGS.
FBA_SHEET_ID=
FBA_SHEET_GID=0

# SKU đang xả hàng (Clear Stock): không đề xuất gửi thêm lên FBA / CastleGate (etl/clear_stock.py)
CLEAR_SHEET_ID=
CLEAR_SHEET_GID=0
